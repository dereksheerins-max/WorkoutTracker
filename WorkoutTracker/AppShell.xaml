<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WorkoutTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WorkoutTracker"
    xmlns:views="clr-namespace:WorkoutTracker.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="WorkoutTracker">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:Views.WorkoutListPage}"
        Route="WorkoutListPage" />

    <ShellContent
        x:Name="AddWorkoutPage"
        Title="Add Workout"
        Route="AddWorkoutPage"
        ContentTemplate="{DataTemplate local:Views.AddWorkoutPage}"
        Shell.ContentTemplate="{DataTemplate local:Views.AddWorkoutPage}" />

</Shell>