<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:WorkoutTracker.Models;assembly=WorkoutTracker.Core"
             xmlns:views="clr-namespace:WorkoutTracker.Views"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels;assembly=WorkoutTracker.Core"
             x:Class="WorkoutTracker.Views.WorkoutListPage"
             x:Name="PageRoot"
             x:DataType="vm:WorkoutListViewModel"
             Title="Workouts"
             Shell.NavBarIsVisible="True">

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding LoadWorkoutsCommand}">
        <CollectionView ItemsSource="{Binding WorkoutSessions}"
                        AutomationId="WorkoutsList"
                        SelectionMode="None"
                        RemainingItemsThreshold="3"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreWorkoutsCommand}">
            <CollectionView.Header>
                <Grid Padding="16" ColumnDefinitions="*,Auto">
                    <Label Text="My Workouts"
                           Style="{StaticResource Headline}"
                           VerticalOptions="Center"/>
                    <Button Text="+"
                            Grid.Column="1"
                            Command="{Binding AddWorkoutCommand}"
                            AutomationId="AddWorkoutButton"
                            SemanticProperties.Description="Add workout"
                            WidthRequest="44"
                            HeightRequest="44"
                            CornerRadius="22"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                </Grid>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:WorkoutSession">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <!-- Bound through the page rather than by walking the
                                     ancestor tree, which is unreliable inside item templates. -->
                                <SwipeItem Text="Delete"
                                           BackgroundColor="Red"
                                           CommandParameter="{Binding .}"
                                           Command="{Binding ViewModel.DeleteWorkoutCommand, Source={x:Reference PageRoot}}"
                                           x:DataType="views:WorkoutListPage"/>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Margin="16,8"
                                Padding="16"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2C}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 8">
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.25" Radius="6" Offset="0,2" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}"
                                                      Command="{Binding ViewModel.EditWorkoutCommand, Source={x:Reference PageRoot}}"
                                                      x:DataType="views:WorkoutListPage"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Name}"
                                           Style="{StaticResource BodyStrong}"
                                           FontSize="18"/>
                                    <Label Text="{Binding Date, StringFormat='{0:MMM dd, yyyy}'}"
                                           TextColor="Gray"
                                           FontSize="14"/>
                                    <Label Text="{Binding ExerciseCount, StringFormat='{0} exercises'}"
                                           TextColor="Gray"
                                           FontSize="14"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Grid Padding="40,60" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Label Text="No workouts yet"
                           FontFamily="OpenSansSemibold"
                           FontSize="24"
                           HorizontalOptions="Center" />
                    <Label Grid.Row="1"
                           Text="Tap + to add your first workout"
                           TextColor="Gray"
                           HorizontalOptions="Center" />
                </Grid>
            </CollectionView.EmptyView>
        </CollectionView>
    </RefreshView>

</ContentPage>
