<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:WorkoutTracker.Models;assembly=WorkoutTracker.Core"
             xmlns:views="clr-namespace:WorkoutTracker.Views"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels;assembly=WorkoutTracker.Core"
             x:Class="WorkoutTracker.Views.AddWorkoutPage"
             x:Name="PageRoot"
             x:DataType="vm:AddWorkoutViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="True">

    <!-- One scroll owner only. A CollectionView inside a ScrollView is measured with
         unbounded height, loses virtualisation and makes gesture arbitration
         undefined, so the exercise list uses BindableLayout: a workout holds a
         handful of exercises and needs no virtualisation. -->
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <VerticalStackLayout.Triggers>
                <DataTrigger TargetType="VerticalStackLayout"
                             Binding="{Binding IsLoading}"
                             Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </VerticalStackLayout.Triggers>

            <Label Text="Workout Name"
                   Style="{StaticResource BodyStrong}"/>
            <Entry Text="{Binding WorkoutName}"
                   Placeholder="e.g., Push Day, Leg Day"/>

            <Label Text="Date"
                   Style="{StaticResource BodyStrong}"/>
            <DatePicker Date="{Binding WorkoutDate}"/>

            <Label Text="Notes (optional)"
                   Style="{StaticResource BodyStrong}"/>
            <Editor Text="{Binding WorkoutNotes}"
                    Placeholder="Add any notes..."
                    HeightRequest="100"/>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Exercises"
                       Style="{StaticResource Headline}"
                       FontSize="20"
                       VerticalOptions="Center"/>
                <Button Text="Add Exercise"
                        Grid.Column="1"
                        Command="{Binding AddExerciseCommand}"
                        SemanticProperties.Hint="Adds an empty exercise to this workout"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        TextColor="White"/>
            </Grid>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Exercise">
                        <Border Margin="0,8"
                                Padding="16"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2C}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 8">
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.25" Radius="6" Offset="0,2" />
                            </Border.Shadow>
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">

                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <Entry Text="{Binding Name}"
                                           Placeholder="Exercise Name"
                                           FontSize="16"/>
                                    <!-- Bound through the page rather than by walking the
                                         ancestor tree, which is unreliable inside item templates. -->
                                    <Button Grid.Column="1"
                                            Text="X"
                                            TextColor="Red"
                                            BackgroundColor="Transparent"
                                            SemanticProperties.Description="Remove exercise"
                                            CommandParameter="{Binding .}"
                                            Command="{Binding ViewModel.RemoveExerciseCommand, Source={x:Reference PageRoot}}"
                                            x:DataType="views:AddWorkoutPage"/>
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Sets"
                                               TextColor="Gray"
                                               FontSize="12"/>
                                        <Entry Keyboard="Numeric"
                                               Text="{Binding Sets}"
                                               Placeholder="3"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Reps"
                                               TextColor="Gray"
                                               FontSize="12"/>
                                        <Entry Keyboard="Numeric"
                                               Text="{Binding Reps}"
                                               Placeholder="10"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                                        <Label Text="Weight (kg)"
                                               TextColor="Gray"
                                               FontSize="12"/>
                                        <Entry Keyboard="Numeric"
                                               Text="{Binding Weight}"
                                               Placeholder="0"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="Save Workout"
                    Command="{Binding SaveWorkoutCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="8"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
