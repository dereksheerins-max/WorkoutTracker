<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GymTracker.ViewModels"
             x:Class="GymTracker.Views.AddWorkoutPage"
             Title="Log Workout">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">
            <Label Text="Log New Activity" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

            <!-- Selection of Equipment -->
            <Label Text="Select Machine:" />
            <Picker Title="Select Activity"
                    ItemsSource="{Binding AvailableTypes}"
                    ItemDisplayBinding="{Binding .}"
                    SelectedItem="{Binding SelectedType}" />

            <!-- Time Input -->
            <Label Text="Time (Minutes):" />
            <Entry Placeholder="e.g. 30"
                   Keyboard="Numeric"
                   Text="{Binding CurrentWorkout.Time}" />

            <!-- Heart Rate -->
            <Label Text="Max Heart Rate:" />
            <Entry Placeholder="e.g. 160"
                   Keyboard="Numeric"
                   Text="{Binding CurrentWorkout.MaxHeartRate}" />

            <!-- Calories -->
            <Label Text="Calories Burned:" />
            <Entry Placeholder="e.g. 400"
                   Keyboard="Numeric"
                   Text="{Binding CurrentWorkout.CaloriesBurned}" />

            <!-- Distance -->
            <Label Text="Distance (km/mi):" />
            <Entry Placeholder="e.g. 5.2"
                   Keyboard="Numeric"
                   Text="{Binding CurrentWorkout.Distance}" />

            <Button Text="Save Workout"
                    Command="{Binding SaveWorkoutCommand}"
                    Margin="0,30,0,0"
                    BackgroundColor="DeepSkyBlue"
                    TextColor="White"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>