<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GymTracker.ViewModels"
             x:Class="GymTracker.Views.MainPage"
             Title="My Training Log">

    <Grid RowDefinitions="Auto,*">
        <!-- Header Section -->
        <StackLayout Grid.Row="0" Padding="20" BackgroundColor="#512BD4">
            <Label Text="Gym Tracker" FontSize="28" FontAttributes="Bold" TextColor="White"/>
            <Button Text="+ Add New Workout"
                    Clicked="OnAddWorkoutClicked"
                    BackgroundColor="White"
                    TextColor="#512BD4"
                    Margin="0,10,0,0"/>
        </StackLayout>

        <!-- List Section -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Workouts}" Margin="10"
             EmptyView="No workouts logged yet. Hit the gym and record your first session!">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="5" Padding="15" CornerRadius="10"
                        BorderColor="#E0E0E0" HasShadow="True">
                        <VerticalStackLayout>
                            <!-- The Title will be the Activity Type (e.g., "Treadmill") -->
                            <Label Text="{Binding Type}"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#512BD4"/>

                            <!-- A separator line or spacing -->
                            <BoxView HeightRequest="1" Color="LightGray" Margin="0,5" />

                <Grid ColumnDefinitions="*,*">
                    <!-- Left side: Time and Date -->
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="{Binding Time, StringFormat='{0:hh:mm tt}'}"
                               FontSize="16"
                               TextColor="Black"/>
                        <Label Text="{Binding DateCreated, StringFormat='{0:MM/dd/yyyy}'}"
                               FontSize="12"
                               TextColor="Gray"/>
                    </VerticalStackLayout>

                    <!-- Right side: Stats -->
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="{Binding Distance, StringFormat='Dist: {0}'}"
                               FontSize="16"
                               TextColor="#2E8B57"/>
                        <Label Text="{Binding Calories, StringFormat='Cals: {0}'}"
                               FontSize="16"
                               TextColor="#D2691E"/>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </Grid>
    </ContentPage>