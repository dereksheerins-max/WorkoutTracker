<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GymTracker.ViewModels"
             x:Class="GymTracker.Views.MainPage"
             Title="My Training Log">

    <Grid RowDefinitions="Auto,*">
        <!-- Header Section -->
        <StackLayout Grid.Row="0" Padding="20" BackgroundColor="#512BD4">
            <Label Text="Gym Tracker" FontSize="28" FontAttributes="Bold" TextColor="White"/>
            <Button Text="+ Add New Workout"
                    Clicked="OnAddWorkoutClicked"
                    BackgroundColor="White"
                    TextColor="#512BD4"
                    Margin="0,10,0,0"/>
        </StackLayout>

        <!-- List Section -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Workouts}" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="5" Padding="15" CornerRadius="10" BorderColor="LightGray">
                        <VerticalStackLayout>
                            <Label Text="{Binding Type}" FontAttributes="Bold" FontSize="18"/>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding Time, StringFormat='{0} mins'}" />
                                <BoxView WidthRequest="1" BackgroundColor="LightGray" VerticalOptions="Center" HeightRequest="20" />
                                <Label Text="{Binding Distance, StringFormat='{0} units'}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding MaxHeartRate, StringFormat='Max HR: {0}'}"
                                   TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>