# The repo root holds only the project entries below. Ignore everything else so
# `git add` can never pick up unrelated files, caches, configs or secrets.
/*
!/WorkoutTracker/
!/WorkoutTracker.Core/
!/WorkoutTracker.Tests/
!/WorkoutTrackerSolution.sln
!/README.md
!/.github/
!/.gitignore

# Abandoned pre-rename project; kept on disk for reference, no longer tracked
GymTracker/

# Ignore build outputs
bin/
obj/
.vs/
.vscode/
*.user
*.suo
*.userprefs

# OS files
.DS_Store
Thumbs.db

# SQLite DBs and local DB files
*.db
*.sqlite
*.db-journal
*.db-wal
*.db-shm

# Rider
.idea/

# NuGet
*.nupkg
packages/

# JetBrains
*.dotCover
