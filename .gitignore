# This repo is rooted at the user's home directory.
# Ignore everything at the root by default, then whitelist only project
# entries — otherwise `git add` can pick up caches, configs, or secrets.
/*
!/WorkoutTracker/
!/WorkoutTracker.Core/
!/WorkoutTracker.Tests/
!/GymTracker/
!/WorkoutTrackerSolution.sln
!/README.md
!/.github/
!/.gitignore

# Accidental nested duplicate of the old project (local only)
GymTracker/GymTracker/

# Ignore build outputs
bin/
obj/
.vs/
.vscode/
*.user
*.suo
*.userprefs

# OS files
.DS_Store
Thumbs.db

# SQLite DBs and local DB files
*.db
*.sqlite
*.db-journal
*.db-wal
*.db-shm

# Rider
.idea/

# NuGet
*.nupkg
packages/

# JetBrains
*.dotCover
